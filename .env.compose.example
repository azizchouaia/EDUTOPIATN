# Copy this file to `.env` at the repo root (same folder as docker-compose.yml).
# docker compose reads THIS file automatically for ${VAR} substitution in
# docker-compose.yml — it is separate from backend/.env, which the app
# container reads for its own runtime config.

DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=edutopiav2
DB_USER=edutopia_app
DB_PASSWORD=change-me-app-password
