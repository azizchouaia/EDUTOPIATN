# Copy this file to backend/.env on the VM and fill in real values.
# Do NOT commit the real .env — it holds live secrets.

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Frontend is served BY this same backend now, so same-origin requests
# send no Origin header at all — but keep your real domain listed too,
# in case you ever call the API from elsewhere (mobile app, etc).
ALLOWED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com

# ── Database (MySQL container, service name "mysql" on the compose network) ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=edutopia_app          # must match DB_USER in root .env
DB_PASSWORD=change-me-app-password   # must match DB_PASSWORD in root .env
DB_NAME=edutopiav2                   # must match DB_NAME in root .env

# ── Auth / JWT ──────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_NEW_ROTATED_SECRET
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=REPLACE_ME

# ── Khlayel AI (LLM) ────────────────────────────────────────
AI_PROVIDER=anthropic
GROQ_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY
ANTHROPIC_API_KEY=REPLACE_ME
MEM0_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY

AI_FREE_DAILY_LIMIT=10
AI_SUB_DAILY_LIMIT=100

# ── Quizzes ─────────────────────────────────────────────────
QUIZ_SIZE=10
QUIZ_PASS_RATIO=0.7

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Edutopia" <your-email@gmail.com>

PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# ── Payments (Konnect) ──────────────────────────────────────
KONNECT_API_URL=https://api.konnect.network/api/v2
KONNECT_API_KEY=REPLACE_ME
KONNECT_WALLET_ID=REPLACE_ME
