# Environment variables — copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS).
# Dev: the Vite frontend. Prod: your real domain(s).
ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5000

# ── Database (MySQL / phpMyAdmin) ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edutopiav2

# ── Auth ────────────────────────────────────────────────────
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
# Google OAuth client ID (same value as the frontend). Empty = Google login disabled.
GOOGLE_CLIENT_ID=

# ── Khlayel AI (LLM) ────────────────────────────────────────
# Provider switch: "groq" (free tier) or "anthropic" (paid, best quality).
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: sonnet + haiku)
# ANTHROPIC_MODEL_REASON=claude-sonnet-4-6
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
# Long-term memory (optional — leave empty to disable)
MEM0_API_KEY=
# Daily message quotas (student role)
AI_FREE_DAILY_LIMIT=10
AI_SUB_DAILY_LIMIT=100

# ── Quizzes ─────────────────────────────────────────────────
QUIZ_SIZE=10
QUIZ_PASS_RATIO=0.7

# ── Email (SMTP) — password reset, activation codes ─────────
MAIL_FROM=Edutopia <no-reply@edutopia.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# ── Payments (Konnect — optional) ───────────────────────────
KONNECT_WALLET_ID=
